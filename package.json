{
  "name": "passkey-client-lib",
  "version": "0.1.0",
  "description": "Angular client library for Keycloak passkey authentication flows",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fesm2022/passkey-client-lib.mjs",
  "module": "./dist/fesm2022/passkey-client-lib.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/passkey-client-lib.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "ng-packagr -p ng-package.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "angular",
    "keycloak",
    "passkey",
    "webauthn",
    "authentication"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ITegs/keycloak-client-lib.git"
  },
  "bugs": {
    "url": "https://github.com/ITegs/keycloak-client-lib/issues"
  },
  "homepage": "https://github.com/ITegs/keycloak-client-lib#readme",
  "peerDependencies": {
    "@angular/common": ">=20.0.0 <21.0.0",
    "@angular/core": ">=20.0.0 <21.0.0",
    "keycloak-js": ">=26.0.0",
    "rxjs": ">=7.8.0"
  },
  "devDependencies": {
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/node": "^22.13.0",
    "ng-packagr": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
